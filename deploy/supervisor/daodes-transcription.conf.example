[program:daodes-transcription]
directory=/home/sergeniyrus/www/daodes
command=/opt/daodes-transcription/venv/bin/uvicorn server:app --app-dir /home/sergeniyrus/www/daodes/services/transcription --host 127.0.0.1 --port 8765 --workers 1
user=sergeniyrus
autostart=true
autorestart=true
startsecs=10
startretries=5
stopsignal=TERM
stopwaitsecs=60
environment=HOME="/home/sergeniyrus",HF_HOME="/home/sergeniyrus/.cache/huggingface",LOCAL_TRANSCRIPTION_TOKEN_FILE="/etc/daodes-transcription.token",WHISPER_MODEL="small",WHISPER_DEVICE="cpu",WHISPER_COMPUTE_TYPE="int8"
stdout_logfile=/var/log/supervisor/daodes-transcription.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
redirect_stderr=true
